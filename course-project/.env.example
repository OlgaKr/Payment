# Copy this file to .env (in this same folder) and paste your own Stripe TEST keys.
# Get them at: https://dashboard.stripe.com/test/apikeys
# .env is gitignored — never commit real keys.

STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE

# Optional: only needed with the stripe-cli webhook forwarder (see README → Webhooks)
# STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET_HERE